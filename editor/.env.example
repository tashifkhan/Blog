# Editor login. Use a long random value, never a personal reused password.
# Required. Prefer a long random value in production.
EDITOR_PASSWORD=
# At least 32 characters; generate independently from EDITOR_PASSWORD.
EDITOR_SESSION_SECRET=

# Set true only when the editor is served over HTTPS. Leave false/unset for
# plain HTTP (e.g. Tailscale home-server on :3100) so the session cookie sticks.
COOKIE_SECURE=false

# GitHub App installed only on the target blog repository with Contents:
# Read and write. Keep the PEM entirely server-side.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

GITHUB_REPOSITORY_OWNER=tashifkhan
GITHUB_REPOSITORY_NAME=Blog
GITHUB_PUBLISH_BRANCH=main
