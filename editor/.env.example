# Editor login. Use a long random value, never a personal reused password.
# Required. Prefer a long random value in production.
EDITOR_PASSWORD=
# At least 32 characters; generate independently from EDITOR_PASSWORD.
EDITOR_SESSION_SECRET=

# Set true only when the editor is served over HTTPS. Leave false/unset for
# plain HTTP (e.g. Tailscale home-server on :3100) so the session cookie sticks.
COOKIE_SECURE=false

# GitHub personal access token with Contents: Read and write on the blog repo.
# Classic: repo (or public_repo if the blog is public only).
# Fine-grained: Repository access = this blog repo; Permissions → Contents = Read and write.
# GITHUB_PAT is accepted as an alias for GITHUB_TOKEN.
GITHUB_TOKEN=

GITHUB_REPOSITORY_OWNER=tashifkhan
GITHUB_REPOSITORY_NAME=Blog
GITHUB_PUBLISH_BRANCH=main

# Optional. When GITHUB_TOKEN is missing, the desk lists/opens posts from:
# 1) local monorepo src/blogs (override with BLOGS_DIR)
# 2) the public blog API below
# Publishing always requires GITHUB_TOKEN.
BLOG_API_BASE=https://blog.tashif.codes/api
BLOG_SITE_ORIGIN=https://blog.tashif.codes
# BLOGS_DIR=/absolute/path/to/src/blogs
