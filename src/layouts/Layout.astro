---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import PostHog from "../components/posthog.astro";
export interface Props {
	title?: string;
	description?: string;
	/** Absolute URL or site-root path for social/OG preview images. */
	image?: string;
}

const { title, description, image } = Astro.props;

const siteOrigin = "https://blog.tashif.codes";
const pageTitle = title
	? `${title} | BlogOS`
	: "BlogOS - A blog website by Tashif";
const pageDescription =
	description ??
	"BlogOS by Tashif - Discover insightful articles, tutorials, and resources on web development, programming, and technology.";
const ogImagePath = image || "/favicon.png";
const ogImage = ogImagePath.startsWith("http")
	? ogImagePath
	: `${siteOrigin}${ogImagePath.startsWith("/") ? "" : "/"}${ogImagePath}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#0f172a" />
		<meta name="description" content={pageDescription} />
		<meta
			name="keywords"
			content="BlogOS, Tashif, blog, web development, programming, technology, tutorials, articles"
		/>
		<meta name="author" content="Tashif" />
		<link rel="canonical" href="https://blog.tashif.codes/" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="BlogOS — Tashif Ahmad Khan"
			href="https://blog.tashif.codes/rss.xml"
		/>
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://blog.tashif.codes/" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:image" content={ogImage} />
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body>
		<PostHog />
		<Analytics />
		<slot />
		<script>
			// Sync theme variables with CSS custom properties
			function syncThemeVariables() {
				const themeEvent = new CustomEvent("sync-theme-vars");
				window.dispatchEvent(themeEvent);
			}

			// Initial sync and listen for theme changes
			document.addEventListener("DOMContentLoaded", syncThemeVariables);
			window.addEventListener("themechange", syncThemeVariables);
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	:root {
		--zoom: 1;
	}
	/*
	 * Use `zoom`, not `transform: scale()`. A transform on <body> makes it the
	 * containing block for `position: fixed` descendants, which breaks every Radix
	 * popper: menubar/dropdown content is portaled into <body> and positioned with
	 * strategy "fixed", so open menus drifted away by exactly the scroll offset.
	 * `zoom` also reflows layout instead of only scaling it visually, so zooming in
	 * no longer overflows the viewport.
	 */
	body {
		zoom: var(--zoom);
	}
	@media (max-width: 640px) {
		body {
			zoom: 1;
		}
	}

	/* Theme variables sync */
	:root {
		--theme-bg: #fdfd96;
		--theme-text: #000000;
		--theme-accent: #ff498b;
		--theme-border: #000000;
		--theme-window-bg: #ffffff;
		--theme-secondary: #4deeea;
		--theme-muted: #74ee15;
	}
</style>
