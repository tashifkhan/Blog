---
/**
 * Renders a post body.
 *
 * Parsing, structure, and directives come from packages/markdown, which is the
 * same module tashif.codes and the editor's reading pane use — before that this
 * component ran its own remark pipeline plus a series of regex passes over the
 * generated HTML, so the same post looked different on each site and callouts
 * only worked on one of them. Visual styling lives in markdown-theme.css.
 */
import { renderMarkdown } from "../../packages/markdown";
import "../styles/markdown-theme.css";

interface Props {
	content?: string;
	githubBaseUrl?: string;
	class?: string;
}

const { content, githubBaseUrl, class: className = "" } = Astro.props;

const html = content
	? renderMarkdown(content, {
			githubBaseUrl,
			// `/images/blog/...` is served by this site, so root-relative URLs are
			// left alone rather than rewritten onto raw.githubusercontent.
			rootRelative: "site",
			// No post uses a diagram, so the mermaid bundle is not shipped; a
			// diagram fence renders as a readable code block instead.
			mermaid: false,
		})
	: "<p>No content provided.</p>";
---

<div
	class:list={["markdown-body", "markdown-content", className]}
	set:html={html}
/>

<script>
	import { initCopyButtons } from "../../packages/markdown/client";

	initCopyButtons();
</script>
