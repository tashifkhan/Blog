---
/**
 * Renders a post body.
 *
 * Parsing, structure, and directives come from packages/markdown, which is the
 * same module tashif.codes and the editor's reading pane use — before that this
 * component ran its own remark pipeline plus a series of regex passes over the
 * generated HTML, so the same post looked different on each site and callouts
 * only worked on one of them. Visual styling lives in markdown-theme.css.
 */
import { renderMarkdown } from "../../packages/markdown";
import "../styles/markdown-theme.css";

interface Props {
	content?: string;
	githubBaseUrl?: string;
	class?: string;
}

const { content, githubBaseUrl, class: className = "" } = Astro.props;

const html = content
	? renderMarkdown(content, {
			githubBaseUrl,
			// `/images/blog/...` is served by this site, so root-relative URLs are
			// left alone rather than rewritten onto raw.githubusercontent.
			rootRelative: "site",
			// tashif.codes renders these same posts with diagrams enabled, so a
			// post containing one has to render the same here. The bundle is
			// imported lazily below, so prose-only posts pay nothing for it.
			mermaid: true,
		})
	: "<p>No content provided.</p>";
---

<div
	class:list={["markdown-body", "markdown-content", className]}
	set:html={html}
/>

<script>
	import {
		initCopyButtons,
		isDarkTheme,
		renderMermaidBlocks,
		watchForContent,
		watchThemeChanges,
	} from "../../packages/markdown/client";

	// Only fetched when a post actually contains a diagram, so the mermaid
	// bundle stays out of the critical path for ordinary prose posts.
	async function drawDiagrams(force = false) {
		if (!document.querySelector(".md-mermaid")) return;
		const { default: mermaid } = await import("mermaid");
		await renderMermaidBlocks(mermaid, { dark: isDarkTheme(), force });
	}

	initCopyButtons();
	watchForContent(() => void drawDiagrams());
	watchThemeChanges(() => void drawDiagrams(true));
</script>
